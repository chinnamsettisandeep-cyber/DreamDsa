import java.util.Arrays;
public class Main {
    public static void main(String[] args) {
        int[][] arr = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
        int r = arr.length;
        int c = arr[0].length;
        int[] b = new int[r * c];
        int k = 0;
        for(int i = 0; i < r; i++) {
            for(int j = 0; j < c; j++) {
                b[k] = arr[i][j];
                k++;
            }
        }
        System.out.println(Arrays.toString(b));
    }
}
